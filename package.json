{
  "name": "flowweave",
  "version": "0.1.0",
  "description": "Visual bridge for Codex-style programming agents.",
  "author": "FlowWeave",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/check-brand-assets.mjs && npm run typecheck && electron-vite build && node scripts/check-bundle-size.mjs",
    "benchmark": "node --import tsx scripts/run-performance-benchmarks.ts",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac:arm64": "npm run build && electron-builder --mac --dir --arm64",
    "dist:win:x64": "npm run build && electron-builder --win nsis --x64",
    "dist:win:arm64": "npm run build && electron-builder --win nsis --arm64",
    "smoke:agent": "node --import tsx scripts/run-agent-smoke.ts",
    "smoke:packaged": "node scripts/run-packaged-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vue/compiler-sfc": "^3.5.36",
    "@xyflow/react": "^12.9.3",
    "elkjs": "^0.11.1",
    "fast-glob": "^3.3.3",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "web-tree-sitter": "^0.26.9",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^5.9.3",
    "tsx": "^4.22.1",
    "vite": "^7.3.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "postcss": "8.5.25"
  },
  "build": {
    "appId": "com.flowweave.app",
    "productName": "FlowWeave",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "logo/flowweave-app-icon.png",
        "to": "flowweave-app-icon.png"
      },
      {
        "from": "flowweave-plugin",
        "to": "flowweave-plugin"
      },
      {
        "from": "node_modules/web-tree-sitter/web-tree-sitter.wasm",
        "to": "parsers/web-tree-sitter.wasm"
      },
      {
        "from": "node_modules/tree-sitter-python/tree-sitter-python.wasm",
        "to": "parsers/tree-sitter-python.wasm"
      },
      {
        "from": "node_modules/tree-sitter-java/tree-sitter-java.wasm",
        "to": "parsers/tree-sitter-java.wasm"
      },
      {
        "from": "node_modules/tree-sitter-go/tree-sitter-go.wasm",
        "to": "parsers/tree-sitter-go.wasm"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "logo/flowweave-app-icon.png",
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "logo/flowweave-app-icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
