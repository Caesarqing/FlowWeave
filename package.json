{
  "name": "flowweave",
  "version": "0.1.0",
  "description": "Visual bridge for Codex-style programming agents.",
  "author": "FlowWeave",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/check-bundle-size.mjs",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.9.3",
    "fast-glob": "^3.3.3",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "dompurify": "^3.4.0"
  },
  "build": {
    "appId": "com.flowweave.app",
    "productName": "FlowWeave",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "logo/logo.png",
        "to": "logo.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "logo/logo.png",
      "target": [
        "dir"
      ]
    }
  }
}
